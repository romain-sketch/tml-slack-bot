                "image_url": "https:\/\/media.licdn.com\/dms\/image\/v2\/D4E22AQEW_eA6_IazUQ\/feedshare-shrink_2048_1536\/B4EZX7Zu5QHYAo-\/0\/1743679582677?e=2147483647&v=beta&t=wxksqXAFt242QMNz9CrsGCPGdjLBk7rJGPILbIY8Ilw",
                "image_width": 1200,
