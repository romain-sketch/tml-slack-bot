                                    "bold": true
                                }
                            },
                            {
                                "type": "text",
                                "text": " give the same list of brands or recommendations twice (<1 in 100 times, no matter the question)\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_list",
                        "elements": [
                            {
                                "type": "rich_text_section",
                                "elements": [
                                    {
                                        "type": "text",
                                        "text": "AIs "
                                    },
                                    {
                                        "type": "text",
