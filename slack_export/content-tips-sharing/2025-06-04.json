                        "ts": "1741102864.734419",
                        "message": {
                            "blocks": [
                                {
                                    "type": "rich_text",
                                    "block_id": "lLSka",
                                    "elements": [
                                        {
                                            "type": "rich_text_section",
                                            "elements": [
                                                {
                                                    "type": "text",
                                                    "text": "Réponse assez longue et loin d'être exhaustive "
                                                },
                                                {
                                                    "type": "emoji",
                                                    "name": "smile",
                                                    "unicode": "1f604"
                                                },
                                                {
                                                    "type": "text",
                                                    "text": "\n\nSur votre site, la base c'est les mêmes recommandations que Google a toujours faites:\n"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "rich_text_list",
                                            "elements": [
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "focus sur EEAT (Experience, Expertise, Authoritativeness, and Trustworthiness)"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "site bien organisé, facile à comprendre pour humains et robots (sitemap, vitesse de chargement, accessibilité, internal linking, viser le max de clic le plus bas possible pour atteindre votre contenu le plus profond (ex: combien de clics depuis la home jusqu'à votre plus vieil article de blog en utilisant uniquement la navigation?))"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "contenu updaté régulièrement, avec forte valeur ajoutée vs les autres sites (rejoint EEAT)"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "edit: et pour maintenir la lead gen => favorisez les contenus qui forcent les users à aller sur votre site pour en tirer de la valeur (ex: mini outils, assets à télécharger etc)"
                                                        }
                                                    ]
                                                }
                                            ],
                                            "style": "bullet",
                                            "indent": 0,
                                            "border": 0
                                        },
                                        {
                                            "type": "rich_text_section",
                                            "elements": [
                                                {
                                                    "type": "text",
                                                    "text": "\nSur votre site, ce qui est nouveau:\n"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "rich_text_list",
                                            "elements": [
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "Baisse de valeur des keywords stricts et hausse de la valeur de la long tail (ex: on adressait \"best webinar software\" avec une page dédiée bourrée de ce KW, maintenant on va plutôt query \"what is the best webinar software\" et voir ce qui sort + faire evoluer notre contenu pour plutot adresser ce genre de requete, plutot qu'un mot clé très précis)"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "Plus largement : hausse de la valeur de pages à faible impact SEO \"d'avant\", mais fort impact \"faire comprendre à l'IA ce que mon produit permet et propose\". Pour nous c'est un effort ++ sur :"
                                                        }
                                                    ]
                                                }
                                            ],
                                            "style": "bullet",
                                            "indent": 0,
                                            "border": 0
                                        },
                                        {
                                            "type": "rich_text_list",
                                            "elements": [
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "pages produit"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "détail sur nos fonctionnalités (pour être sur d'apparaître sur les demandes précises)"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "dévelopement industries\/use cases\/usage par équipe => avant c'était juste pour les gens qui visitent le site, maintenant c'est pour que ce soit compréhensible dans le contexte de Google AI overview ou Chat IA"
                                                        }
                                                    ]
                                                }
                                            ],
                                            "style": "bullet",
                                            "indent": 1,
                                            "border": 0
                                        },
                                        {
                                            "type": "rich_text_list",
                                            "elements": [
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "Mise en place llms.txt qui aide les IA à scanner le site"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "Ajouter des éléments FAQ pertinents (le format question\/réponse match bien avec l'usage des humains de l'IA, donc on pense que ça peut permettre de pop dans les résultats plus facilement)"
                                                        }
                                                    ]
                                                }
                                            ],
                                            "style": "bullet",
                                            "indent": 0,
                                            "border": 0
                                        },
                                        {
                                            "type": "rich_text_section",
                                            "elements": [
                                                {
                                                    "type": "text",
                                                    "text": "\nHors de votre site:\n"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "rich_text_list",
                                            "elements": [
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "importance RP ++"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "probablement baisse de l'importance des backlinks par rapport aux mentions simple du nom de la marque\/produit"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "importance sites 3rd party et user generated content (Reddit, Trustpilot, Quora etc => probablement utilisés comme signaux pour estimer la qualité d'un tool)"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "rich_text_section",
                                                    "elements": [
                                                        {
                                                            "type": "text",
                                                            "text": "et importance de cleaner les infos sur les 3rd party (review sites, articles affiliates etc) => ex si vous changez de pricing, de positionnement, lancez une feature majeure... il faut qu'ils updatent leur contenu pour aider l'IA pour prendre la vraie info (vous pouvez reverse engineer en partant de requetes et voir ce qui ressort. Par ex nous on ressort comme un outil Webinar pour SMB alors qu'on est maintenant positionnés Mid market +. Visible sur les chatbots IA mais ça va probablement aussi nous pénaliser sur Google IA overview)."
                                                        }
                                                    ]
                                                }
                                            ],
                                            "style": "bullet",
                                            "indent": 0,
                                            "border": 0
                                        },
                                        {
                                            "type": "rich_text_section",
                                            "elements": [
                                                {
                                                    "type": "text",
                                                    "text": "\nEt un tip: Semrush commence à montrer des previews de IA Overview sur certaines des requêtes => on utilise ça pour monitor sur quels sujets l'IA overview apparait et commencer à affiner notre contenu dessus."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    }
